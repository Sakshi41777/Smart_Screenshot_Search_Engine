PORT=5001
MONGO_URI=mongodb://localhost:27017/smart_screenshot_db
CLIENT_ORIGIN=
EMAIL_VERIFICATION_REQUIRED=false
JWT_SECRET=replace_with_secure_secret
TOKEN_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:5001/api/auth/google/desktop/callback
GOOGLE_OAUTH_SCOPES=openid email profile

# Email delivery (scalable)
# EMAIL_PROVIDER can be: resend | smtp (or leave empty for auto-detect)
EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_FROM=noreply@yourdomain.com
RESEND_BASE_URL=https://api.resend.com

# SMTP fallback (optional)
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# LLM provider config (choose one)
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Gemini provider (used when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# AI query assistance
AI_QUERY_ASSIST=true
AI_QUERY_TIMEOUT_MS=12000
AI_QUERY_MIN_CHARS=4
AI_LLM_RERANK_ENABLED=true
AI_LLM_RERANK_MAX_CANDIDATES=80
AI_LLM_RERANK_TIMEOUT_MS=12000

# AI semantic search (embedding-based rerank)
AI_SEMANTIC_SEARCH=true
AI_SEMANTIC_MODEL=text-embedding-3-small
AI_SEMANTIC_MAX_CANDIDATES=220
AI_SEMANTIC_TIMEOUT_MS=12000

# Open-vocabulary image understanding (AI captions/tags for images)
OPEN_VOCAB_IMAGE_INDEX=true
OPEN_VOCAB_QUERY_ENRICH_LIMIT=20

# OCR behavior (skip if already indexed)
OCR_SKIP_IF_EXISTS=true

# Local vision service (BLIP captions + CLIP embeddings)
LOCAL_VISION_URL=http://127.0.0.1:5055
CLIP_IMAGE_RERANK_ENABLED=true
CLIP_TIMEOUT_MS=8000
CLIP_MIN_CHARS=3
CLIP_MAX_CANDIDATES=200
LOCAL_CLIP_MODEL=ViT-B-32
LOCAL_CLIP_PRETRAINED=laion2b_s34b_b79k

# Hybrid ranking confidence filter
HYBRID_RANKING_ENABLED=true
HYBRID_MIN_CONFIDENCE=0.38
HYBRID_MAX_RESULTS=300

# Optional public sharing via Cloudinary
# Use unsigned preset OR signed API key/secret flow.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=smartshot-shares

# Safe maintenance cleanup (disabled by default)
CLEANUP_ENABLED=false
CLEANUP_DRY_RUN=true
CLEANUP_INTERVAL_HOURS=24
CLEANUP_UPLOADS_DAYS=30
CLEANUP_THUMBS_DAYS=14
CLEANUP_HISTORY_DAYS=30
